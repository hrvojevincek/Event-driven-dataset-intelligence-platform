# =============================================================================
# EventForge — Backend environment template
# Copy to .env or rely on repo-root .env when running locally.
# =============================================================================

# --- General ---
ENVIRONMENT=local
LOG_LEVEL=INFO

# --- Database (Postgres) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=eventforge
POSTGRES_USER=eventforge
POSTGRES_PASSWORD=changeme

# --- AWS (local: LocalStack; prod: real AWS) ---
AWS_REGION=eu-west-2
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
EVENT_BUS_NAME=eventforge-bus
SQS_QUEUE_PREFIX=eventforge
SQS_MAX_RECEIVE_COUNT=3

# --- LLM providers ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_DEFAULT_MODEL=gpt-4o-mini
LLM_MAX_OUTPUT_TOKENS=4096
PREPROCESSING_SEGMENT_SIZE_TOKENS=512
PREPROCESSING_SEGMENT_OVERLAP_TOKENS=50
JOB_MAX_COST_USD=2.0

# --- Annotation fan-out (local SQS vs Step Functions Map) ---
ANNOTATION_ORCHESTRATION_MODE=local

# --- ASR (WAV preprocessing; optional — uv sync --extra asr) ---
ASR_PROVIDER=local
ASR_LOCAL_MODEL=small
ASR_OPENAI_MODEL=whisper-1
ASR_DEVICE=cpu

# --- Observability ---
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=eventforge-api
