# =============================================================================
# EventForge — Root environment template
# Copy to .env and fill in values. Service-specific overrides live in
# frontend/.env.example and backend/.env.example
# =============================================================================

# --- General ---
ENVIRONMENT=local
LOG_LEVEL=INFO

# --- Database (Postgres) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=eventforge
POSTGRES_USER=eventforge
POSTGRES_PASSWORD=changeme

# --- AWS (local: LocalStack; prod: real AWS) ---
AWS_REGION=eu-west-2
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
EVENT_BUS_NAME=eventforge-bus
SQS_QUEUE_PREFIX=eventforge
SQS_MAX_RECEIVE_COUNT=3

# --- LLM providers ---
# When ENVIRONMENT=local, mock legacy embeddings are used by default (no OpenAI embedding spend).
# LLM calls always use real providers when API keys are set.
# Set MOCK_EXTERNAL_APIS=false to call real embedding API locally too.
MOCK_EXTERNAL_APIS=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
TAVILY_API_KEY=
LLM_DEFAULT_MODEL=gpt-4o-mini
LLM_MAX_OUTPUT_TOKENS=4096
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_CHUNK_SIZE_TOKENS=512
EMBEDDING_CHUNK_OVERLAP_TOKENS=50

# --- File uploads (local disk) ---
UPLOAD_ROOT=backend/data/uploads
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=eventforge

# --- Frontend (passed through docker-compose) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
